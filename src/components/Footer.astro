<footer class="w-full border-t border-[var(--border)] bg-[var(--card)] py-8 px-4 sm:px-6 lg:px-8 mt-auto transition-colors duration-200">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left">
    
    <!-- Info & License -->
    <div class="space-y-1">
      <p class="text-xs font-serif text-[var(--foreground)] font-medium">
        Curated showcase for <a href="https://github.com/mylinuxforwork/wallpaper" target="_blank" rel="noopener" class="underline hover:text-[var(--accent)]">github.com/mylinuxforwork/wallpaper</a>
      </p>
      <p class="text-[11px] text-[var(--muted-foreground)] max-w-xl">
        Released under the GPL-2.0 license. Wallpapers are curated third-party works hosted remotely; no original authorship claimed.
      </p>
    </div>

    <!-- Tech Stack Pill -->
    <div class="flex items-center gap-2 font-mono text-[11px] text-[var(--muted-foreground)] bg-[var(--muted)] px-3 py-1.5 rounded-full border border-[var(--border)]">
      <span class="w-2 h-2 rounded-full bg-[var(--primary)] animate-pulse"></span>
      <span>Astro Static Site • jsDelivr CDN • 218 Wallpapers</span>
    </div>

  </div>
</footer>
