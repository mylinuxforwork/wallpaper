---
import WallpaperCard, { type Wallpaper } from './WallpaperCard.astro';

interface Props {
  wallpapers: Wallpaper[];
}

const { wallpapers } = Astro.props;
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  
  <!-- Masonry Container -->
  <div
    id="gallery-masonry"
    class="columns-1 sm:columns-2 lg:columns-3 xl:columns-4 2xl:columns-5 gap-4 space-y-4"
  >
    {wallpapers.map((wallpaper, idx) => (
      <WallpaperCard wallpaper={wallpaper} index={idx} />
    ))}
  </div>

  <!-- Empty / No Results State -->
  <div
    id="empty-state"
    class="hidden flex-col items-center justify-center py-20 text-center space-y-4"
  >
    <div class="w-16 h-16 rounded-full bg-[var(--muted)] border border-[var(--border)] flex items-center justify-center text-[var(--muted-foreground)] mb-2">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>
    <h3 class="text-lg font-serif font-semibold text-[var(--foreground)]">No wallpapers found</h3>
    <p class="text-sm text-[var(--muted-foreground)] max-w-sm">
      We couldn't find any wallpapers matching your search or category filter. Try clearing your filters.
    </p>
    <button
      id="btn-reset-filters"
      type="button"
      class="px-4 py-2 rounded-[var(--radius)] bg-[var(--primary)] text-[var(--primary-foreground)] text-xs font-semibold hover:opacity-90 transition-opacity cursor-pointer"
    >
      Reset Filters
    </button>
  </div>

</div>
